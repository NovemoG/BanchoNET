DOMAIN=example.com
SERVER_PORT=16727

# Name used for lazer package
LAZER_NAME=osubanchonet

# Database options
MYSQL_HOST=banchonet-db
MYSQL_PORT=5432
MYSQL_USER=banchonet
MYSQL_PASS=banchonet
MYSQL_DB=utopia

# Redis options
REDIS_HOST=banchonet-redis
REDIS_PORT=6379
REDIS_PASS=

# Mongo options
MONGO_HOST=banchonet-mongo
MONGO_PORT=27017
MONGO_DB=utopia
MONGO_USER=
MONGO_PASS=

# Path to where store the files on the disk
DATA_PATH=./data

# Server Settings
DEBUG=false
BANCHONET_VERSION=0.11.0
COMMAND_PREFIX="!"
VERSION_FETCH_INTERVAL_IN_HOURS=24
DAYS_UNTIL_PLAYER_IS_MARKED_INACTIVE=14
DISALLOW_OLD_CLIENTS=true
# Comma separated
DISALLOWED_NAMES="vaxei,mrekk,cookiezi"

# Messages
WELCOME_MESSAGE=""
FIRST_LOGIN_MESSAGE=""
RESTRICTED_MESSAGE=""

# Leaderboards and scores related
SORT_LEADERBOARD_BY_PP=false
SUBMIT_BY_PP=false
SCORES_ON_LEADERBOARD=50
DISPLAY_PP_IN_NOTIFICATION=false
DISPLAY_SCORE_IN_NOTIFICATION=false

# Banner (check if this still works)
MENU_ICON_URL=
MENU_ONCLICK_URL=

# Fallback for beatmap download to use after your osu session hits rate limit (only if OSU_COOKIE is provided)
OSU_DIRECT_DOWNLOAD_ENDPOINT="https://osu.direct/d"
# Empty means indefinite, any other will remove downloaded .osz file after provided days
BEATMAP_EVICT_DAYS=

# BanchoBot by default
BANCHO_BOT_NAME=
# Valid statuses are: Online, AFK, Playing, Editing, Modding, Multiplayer, Watching, Idle,
# Testing, Submitting, Paused, Lobby, Multiplaying, Target, Unknown
# Example: "Submitting:a pull request..,Editing:the source code.."
BOT_STATUSES=""
BOT_STATUS_UPDATE_INTERVAL=5

# Discord Bot related
DISCORD_TOKEN=
DISCORD_DEBUG_GUILD_ID=

# Required for official api v2 beatmap lookup
CLIENT_ID=
CLIENT_SECRET=

# Optional but recommended for fully working beatmap download
# Must be provided by an endpoint every time it expires
OSU_COOKIE=""

# Required for automatic lazer updates
GITHUB_TOKEN=