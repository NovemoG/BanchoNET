<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <LangVersion>14</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
        <PackageReference Include="dotenv.net" Version="4.0.2" />
        <PackageReference Include="DSharpPlus" Version="5.0.0-nightly-02590" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.10" />
        <PackageReference Include="MongoDB.Driver" Version="3.10.0" />
        <PackageReference Include="Novelog" Version="0.2.3" />
        <PackageReference Include="NRedisStack" Version="1.6.0" />
        <PackageReference Include="Scrutor" Version="7.0.0" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    </ItemGroup>

    <ItemGroup>
      <None Remove=".env" />
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
      <Content Include="..\.env.example">
        <Link>.env.example</Link>
      </Content>
      <Content Include="..\docker-compose.yml">
        <Link>docker-compose.yml</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Novelog" />
        <Using Include="Novelog.Abstractions" />
        <Using Remove="Microsoft.Extensions.Logging" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\BanchoNET.BeatmapServer\BanchoNET.BeatmapServer.csproj" />
      <ProjectReference Include="..\BanchoNET.Bot\BanchoNET.Bot.csproj" />
      <ProjectReference Include="..\BanchoNET.Core\BanchoNET.Core.csproj" />
      <ProjectReference Include="..\BanchoNET.Handlers.Lazer\BanchoNET.Handlers.Lazer.csproj" />
      <ProjectReference Include="..\BanchoNET.Handlers.Stable\BanchoNET.Handlers.Stable.csproj" />
      <ProjectReference Include="..\BanchoNET.Infrastructure\BanchoNET.Infrastructure.csproj" />
    </ItemGroup>

	<Target Name="CopyPpDll" AfterTargets="AfterBuild">
		<Copy SourceFiles="..\BanchoNET.Core\Dependencies\libpp_cs.so" DestinationFolder="$(OutDir)" />
	</Target>
	
	<Target Name="CopyPpDllPublish" AfterTargets="Publish">
		<Copy SourceFiles="..\BanchoNET.Core\Dependencies\libpp_cs.so" DestinationFolder="$(PublishDir)" />
	</Target>

</Project>
